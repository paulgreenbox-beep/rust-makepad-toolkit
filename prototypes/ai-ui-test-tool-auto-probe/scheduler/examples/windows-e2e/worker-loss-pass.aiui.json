{
  "version": 1,
  "name": "scheduler-e2e-worker-loss-pass",
  "application": {
    "command": "scheduler-fixture:advanced",
    "window_title": "AI UI Advanced Makepad Probe"
  },
  "options": {
    "stop_on_error": true,
    "evidence_on_failure": true,
    "semantic_only": true
  },
  "steps": [
    {
      "op": "session.open",
      "save_session_as": "app"
    },
    {
      "op": "get_runtime_health",
      "session": "app"
    }
  ],
  "teardown": [
    {
      "op": "session.close",
      "session": "app"
    }
  ]
}
