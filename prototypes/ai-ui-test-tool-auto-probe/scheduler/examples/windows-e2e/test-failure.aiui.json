{
  "version": 1,
  "name": "scheduler-e2e-test-failure",
  "application": {
    "command": "scheduler-fixture:spatial",
    "window_title": "AI UI Spatial Demo"
  },
  "options": {
    "stop_on_error": true,
    "evidence_on_failure": true,
    "semantic_only": true
  },
  "steps": [
    {
      "op": "session.open",
      "save_session_as": "app"
    },
    {
      "step_id": "intentional-assertion-failure",
      "op": "assert_visible",
      "session": "app",
      "id": "window.main/does.not.exist"
    }
  ],
  "teardown": [
    {
      "op": "session.close",
      "session": "app"
    }
  ]
}
