{
  "version": 1,
  "name": "async-observation-missing-milestone-e2e",
  "application": {
    "command": "prototypes/ai-ui-test-tool-auto-probe/target/debug/ai-ui-advanced-demo.exe",
    "window_title": "AI UI Advanced Makepad Probe",
    "fixture_async_failure_mode": "missing_milestone"
  },
  "options": {
    "stop_on_error": true,
    "evidence_on_failure": true
  },
  "tags": [
    "observation",
    "async",
    "failure-injection",
    "missing_milestone"
  ],
  "setup": [
    {
      "op": "session.open",
      "save_session_as": "app",
      "step_id": "open-session"
    },
    {
      "op": "wait_for_automation_id",
      "session": "app",
      "id": "/button.async",
      "timeout_ms": 10000,
      "step_id": "wait-async-control"
    }
  ],
  "steps": [
    {
      "op": "click",
      "session": "app",
      "id": "/button.async",
      "step_id": "trigger-async"
    },
    {
      "op": "wait_for_api_response",
      "session": "app",
      "request_id": "fixture.request.workflow",
      "timeout_ms": 5000,
      "step_id": "wait-api-response"
    },
    {
      "op": "wait_for_task_complete",
      "session": "app",
      "operation_id": "fixture.async.workflow",
      "timeout_ms": 5000,
      "step_id": "wait-task-complete"
    },
    {
      "op": "assert_task_success",
      "session": "app",
      "operation_id": "fixture.async.workflow",
      "step_id": "assert-task-success"
    },
    {
      "op": "wait_for_runtime_milestone",
      "session": "app",
      "name": "task.completed",
      "timeout_ms": 800,
      "expect_error": "RUNTIME_MILESTONE_TIMEOUT",
      "step_id": "missing-milestone-observed"
    },
    {
      "op": "assert_runtime_milestone",
      "session": "app",
      "name": "task.completed",
      "expect_error": "RUNTIME_MILESTONE_NOT_FOUND",
      "step_id": "missing-milestone-classified"
    },
    {
      "op": "assert_trace_event",
      "session": "app",
      "event": "milestone.suppressed",
      "step_id": "suppression-trace"
    },
    {
      "op": "assert_no_pending_task",
      "session": "app",
      "step_id": "no-pending-after-missing-milestone"
    },
    {
      "op": "get_runtime_timeline",
      "session": "app",
      "step_id": "timeline"
    },
    {
      "op": "get_application_logs",
      "session": "app",
      "step_id": "logs"
    },
    {
      "op": "get_runtime_health",
      "session": "app",
      "step_id": "health"
    },
    {
      "op": "windows_export_evidence",
      "session": "app",
      "reason": "async-observation-missing-milestone-e2e",
      "step_id": "export-evidence"
    }
  ],
  "teardown": [
    {
      "op": "assert_no_pending_task",
      "session": "app",
      "step_id": "cleanup-no-pending-task"
    },
    {
      "op": "assert_no_stale_window",
      "session": "app",
      "step_id": "cleanup-no-stale-window"
    },
    {
      "op": "session.close",
      "session": "app",
      "step_id": "close-session"
    }
  ]
}
