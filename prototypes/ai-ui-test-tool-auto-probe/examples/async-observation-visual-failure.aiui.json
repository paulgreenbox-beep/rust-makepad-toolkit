{
  "version": 1,
  "name": "async-observation-visual-failure-e2e",
  "application": {
    "command": "prototypes/ai-ui-test-tool-auto-probe/target/debug/ai-ui-advanced-demo.exe",
    "window_title": "AI UI Advanced Makepad Probe",
    "fixture_async_failure_mode": "success"
  },
  "options": {
    "stop_on_error": true,
    "evidence_on_failure": true
  },
  "tags": [
    "observation",
    "visual",
    "failure-injection"
  ],
  "setup": [
    {
      "op": "session.open",
      "save_session_as": "app",
      "step_id": "open-session"
    },
    {
      "op": "wait_for_automation_id",
      "session": "app",
      "id": "/button.async",
      "timeout_ms": 10000,
      "step_id": "wait-async-control"
    },
    {
      "op": "screenshot_window",
      "session": "app",
      "extract": {
        "baseline_path": "$.path"
      },
      "step_id": "capture-baseline"
    }
  ],
  "steps": [
    {
      "op": "assert_region_changed",
      "session": "app",
      "baseline_path": "${baseline_path}",
      "current_path": "${baseline_path}",
      "minimum_changed_fraction": 0.001,
      "expect_error": "VISUAL_REGION_UNCHANGED",
      "step_id": "same-capture-must-not-change"
    },
    {
      "op": "assert_no_pending_task",
      "session": "app",
      "step_id": "no-pending-after-visual-failure"
    },
    {
      "op": "get_runtime_timeline",
      "session": "app",
      "step_id": "timeline"
    },
    {
      "op": "get_application_logs",
      "session": "app",
      "step_id": "logs"
    },
    {
      "op": "get_runtime_health",
      "session": "app",
      "step_id": "health"
    },
    {
      "op": "windows_export_evidence",
      "session": "app",
      "reason": "async-observation-visual-failure",
      "step_id": "export-evidence"
    }
  ],
  "teardown": [
    {
      "op": "assert_no_pending_task",
      "session": "app",
      "step_id": "cleanup-no-pending-task"
    },
    {
      "op": "assert_no_stale_window",
      "session": "app",
      "step_id": "cleanup-no-stale-window"
    },
    {
      "op": "session.close",
      "session": "app",
      "step_id": "close-session"
    }
  ]
}
